{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Data Quality Report",
  "type": "object",
  "required": ["run_id", "dataset", "status", "checks"],
  "properties": {
    "run_id": {"type": "string"},
    "dataset": {"type": "string"},
    "status": {"enum": ["PASS", "WARN", "FAIL"]},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "status", "failed_rows"],
        "properties": {
          "rule_id": {"type": "string"},
          "status": {"enum": ["PASS", "WARN", "FAIL"]},
          "failed_rows": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
